+    btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:rgba(var(--text-blue),1)"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="10" y1="10" x2="14" y2="10"/></svg>';
+    btn.addEventListener('mouseenter', function() { btn.style.opacity = '1'; btn.style.background = qsIsDark() ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.06)'; });
